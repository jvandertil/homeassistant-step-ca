#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Home Assistant Add-on: step-ca-client
# ==============================================================================
exit_code_container=$(</run/s6-linux-init-container-results/exitcode)
readonly exit_code_container
readonly exit_code_service="${1}"
readonly exit_code_signal="${2}"
readonly service="renewal-daemon"
retry_backoff_seconds="$(bashio::config 'retry_backoff_seconds')"

if [[ -z "${retry_backoff_seconds}" || "${retry_backoff_seconds}" == 'null' ]]; then
  # Existing installations might not have the newly introduced option yet.
  retry_backoff_seconds=60
elif [[ ! "${retry_backoff_seconds}" =~ ^[1-9][0-9]{0,3}$ ]] || ((10#${retry_backoff_seconds} > 3600)); then
  bashio::log.warning \
    "Configuration option 'retry_backoff_seconds' must be an integer between 1 and 3600; using 60"
  retry_backoff_seconds=60
fi

bashio::log.info \
  "Service ${service} exited with code ${exit_code_service}" \
  "(by signal ${exit_code_signal})"

# Received a signal
if [[ "${exit_code_service}" -eq 256 ]]; then

  # The signal might be a result of another service crashing. Only
  # overwrite the container exit code if it is not already set.
  if [[ "${exit_code_container}" -eq 0 ]]; then
    echo $((128 + exit_code_signal)) > /run/s6-linux-init-container-results/exitcode
  fi

  # If the signal is SIGTERM, we should halt the container and take down
  # the whole  process tree.
  [[ "${exit_code_signal}" -eq 15 ]] && exec /run/s6/basedir/bin/halt

# The service exited with a non-zero exit code. This happens when the CA is
# temporarily unavailable, for example during maintenance. Keep the container
# running so s6 can start the service again after a short backoff.
elif [[ "${exit_code_service}" -ne 0 ]]; then
  bashio::log.warning \
    "Service ${service} failed; retrying in ${retry_backoff_seconds} seconds" \
    "(exit code ${exit_code_service})"
  sleep "${retry_backoff_seconds}"

# The service exited with a zero exit code, which means it exited, let
# S6 supervision restart it.
else
  bashio::log.info "Service ${service} restarting..."
fi
